rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Primitives
    function isSignedIn() { return request.auth != null; }
    
    // Check if user is admin (Bootstrap email or has admin doc)
    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'ronitadhikari690@gmail.com';
    }
    
    function isAdmin() {
       return isSignedIn() && (
         isBootstrappedAdmin() ||
         exists(/databases/$(database)/documents/admins/$(request.auth.uid))
       );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isBootstrappedAdmin();
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Photos Collection
    match /photos/{photoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Birthdays Collection
    match /birthdays/{birthdayId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wishesCount', 'comments']) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wishesCount']) ||
          (
            request.resource.data.wishesCount is int &&
            (
              request.resource.data.wishesCount == resource.data.get('wishesCount', 0) + 1 ||
              request.resource.data.wishesCount == resource.data.get('wishesCount', 0) - 1
            )
          )
        ) &&
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['comments']) ||
          (
            request.resource.data.comments is list &&
            request.resource.data.comments.size() == resource.data.get('comments', []).size() + 1 &&
            request.resource.data.comments.size() <= 200 &&
            request.resource.data.comments[0].text is string &&
            request.resource.data.comments[0].text.size() <= 300 &&
            request.resource.data.comments[0].name is string &&
            request.resource.data.comments[0].name.size() <= 80
          )
        )
      );
    }

    // Calendar Events & Pre-Notices
    match /calendar_events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Media & Event Gallery
    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Downloads Collection
    match /downloads/{downloadId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Student Resources Collection (Syllabus, Schedules, Extracurriculars)
    match /student_resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Citizen Charter & Custom Pages Collections
    match /citizen_charter/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /committees/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
