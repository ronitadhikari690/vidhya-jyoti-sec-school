rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Check if the current user is verified and has an admin document
    // Or bootstrap if their email is ronitadhikari690@gmail.com
    function isBootstrappedAdmin() {
      return isSignedIn() && 
             request.auth.token.email_verified == true && 
             request.auth.token.email == 'ronitadhikari690@gmail.com';
    }
    
    function isAdmin() {
       return isSignedIn() && 
              request.auth.token.email_verified == true && 
              (
                exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
                isBootstrappedAdmin()
              );
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isBootstrappedAdmin() 
                      && isValidId(adminId)
                      && adminId == request.auth.uid
                      && incoming().keys().hasAll(['email', 'roles', 'createdAt'])
                      && incoming().keys().size() == 3
                      && incoming().email == request.auth.token.email
                      && incoming().roles is list
                      && incoming().roles.size() > 0
                      && incoming().roles[0] == 'admin'
                      && incoming().createdAt == request.time;
      allow update, delete: if isBootstrappedAdmin(); // Only the bootstrap admin can modify other admins
    }

    // Notices Collection
    match /notices/{noticeId} {
      allow read: if true; // Public read
      allow create: if isAdmin() 
                      && isValidId(noticeId)
                      && incoming().keys().hasAll(['title', 'excerpt', 'date', 'category', 'createdAt', 'updatedAt'])
                      && incoming().title is string && incoming().title.size() <= 200 && incoming().title.size() > 0
                      && incoming().excerpt is string && incoming().excerpt.size() <= 500
                      && incoming().date is string
                      && incoming().category is string
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
      allow update: if isAdmin()
                      && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'excerpt', 'content', 'imageUrl', 'date', 'category', 'updatedAt'])
                      && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(noticeId);
    }

    // Staff Collection
    match /staff/{staffId} {
      allow read: if true;
      allow create: if isAdmin()
                      && isValidId(staffId)
                      && incoming().keys().hasAll(['name', 'role', 'category', 'createdAt', 'updatedAt'])
                      && incoming().name is string && incoming().name.size() <= 100 && incoming().name.size() > 0
                      && incoming().role is string && incoming().role.size() <= 100
                      && incoming().category is string
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
      allow update: if isAdmin()
                      && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'role', 'phone', 'subject', 'imageUrl', 'category', 'updatedAt'])
                      && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(staffId);
    }

    // Settings Collection
    match /settings/{settingId} {
      // Allow public read for site configuration
      allow read: if true;
      allow create: if isAdmin() && isValidId(settingId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Photos Collection
    match /photos/{photoId} {
       allow read: if true;
       allow create: if isAdmin()
                      && isValidId(photoId)
                      && incoming().keys().hasAll(['url', 'category', 'createdAt', 'updatedAt'])
                      && incoming().url is string
                      && incoming().category is string
                      && incoming().createdAt == request.time
                      && incoming().updatedAt == request.time;
       allow update: if isAdmin()
                      && incoming().diff(existing()).affectedKeys().hasOnly(['url', 'caption', 'category', 'updatedAt'])
                      && incoming().updatedAt == request.time;
       allow delete: if isAdmin() && isValidId(photoId);
    }
  }
}
